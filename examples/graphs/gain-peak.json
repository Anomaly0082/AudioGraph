{
  "schema_version": 1,
  "nodes": [
    {"id": "input", "type": "wav_input", "parameters": {"path": "input.wav"}},
    {"id": "gain", "type": "gain", "parameters": {"gain_db": -6}},
    {"id": "meter", "type": "peak_meter", "parameters": {}},
    {"id": "output", "type": "wav_output", "parameters": {"path": "gain-peak.wav"}}
  ],
  "connections": [
    {"from": {"node": "input", "port": "audio"}, "to": {"node": "gain", "port": "audio"}},
    {"from": {"node": "gain", "port": "audio"}, "to": {"node": "meter", "port": "audio"}},
    {"from": {"node": "gain", "port": "audio"}, "to": {"node": "output", "port": "audio"}}
  ],
  "exports": [
    {"name": "peak", "node": "meter", "port": "peak"},
    {"name": "file", "node": "output", "port": "path"}
  ]
}
