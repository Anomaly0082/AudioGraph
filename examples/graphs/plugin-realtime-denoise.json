{
  "schema_version": 1,
  "nodes": [
    {"id": "input", "type": "realtime_input", "parameters": {"device_id": "SELECT_INPUT_DEVICE"}},
    {"id": "denoise", "type": "org.audiograph.rnnoise.realtime_v1", "parameters": {}},
    {"id": "gain", "type": "realtime_gain", "parameters": {"gain_db": -6}},
    {"id": "output", "type": "realtime_output", "parameters": {"device_id": "SELECT_OUTPUT_DEVICE"}}
  ],
  "connections": [
    {"from": {"node": "input", "port": "audio"}, "to": {"node": "denoise", "port": "audio"}},
    {"from": {"node": "denoise", "port": "audio"}, "to": {"node": "gain", "port": "audio"}},
    {"from": {"node": "gain", "port": "audio"}, "to": {"node": "output", "port": "audio"}}
  ],
  "exports": []
}
