foreach(input IN ITEMS PLUGIN_FILE NODES_FILE COPYING_FILE NOTICE_FILE)
    if(NOT DEFINED ${input} OR NOT EXISTS "${${input}}")
        message(FATAL_ERROR "RNNoise package input ${input} is missing")
    endif()
endforeach()
if(NOT DEFINED PACKAGE_DIR)
    message(FATAL_ERROR "PACKAGE_DIR is missing")
endif()
get_filename_component(ENTRY "${PLUGIN_FILE}" NAME)
file(MAKE_DIRECTORY "${PACKAGE_DIR}/resources")
file(COPY_FILE "${PLUGIN_FILE}" "${PACKAGE_DIR}/${ENTRY}" ONLY_IF_DIFFERENT)
file(COPY_FILE "${NODES_FILE}" "${PACKAGE_DIR}/nodes.json" ONLY_IF_DIFFERENT)
file(COPY_FILE "${COPYING_FILE}" "${PACKAGE_DIR}/resources/COPYING" ONLY_IF_DIFFERENT)
file(COPY_FILE "${NOTICE_FILE}" "${PACKAGE_DIR}/resources/NOTICE" ONLY_IF_DIFFERENT)
file(SHA256 "${PACKAGE_DIR}/${ENTRY}" ENTRY_SHA256)
file(SHA256 "${PACKAGE_DIR}/nodes.json" NODES_SHA256)
file(SHA256 "${PACKAGE_DIR}/resources/COPYING" COPYING_SHA256)
file(SHA256 "${PACKAGE_DIR}/resources/NOTICE" NOTICE_SHA256)
configure_file("${CMAKE_CURRENT_LIST_DIR}/manifest.json.in" "${PACKAGE_DIR}/manifest.json" @ONLY)
