cmake_minimum_required(VERSION 3.25)

# Export only public authoring assets; never merge into an existing directory.
if(NOT DEFINED OUTPUT_DIR OR OUTPUT_DIR STREQUAL "" OR NOT IS_ABSOLUTE "${OUTPUT_DIR}")
    message(FATAL_ERROR "OUTPUT_DIR must be a new absolute directory path")
endif()
cmake_path(NORMAL_PATH OUTPUT_DIR OUTPUT_VARIABLE destination)
if(EXISTS "${destination}" OR IS_SYMLINK "${destination}")
    message(FATAL_ERROR "Refusing existing OUTPUT_DIR: ${destination}")
endif()
get_filename_component(source_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
file(REAL_PATH "${source_root}" source_root)
# Resolve existing ancestors too, so a junction cannot redirect build/out into
# source assets. Only the two ignored output trees may receive in-repo exports.
set(existing_ancestor "${destination}")
set(missing_suffix "")
while(NOT EXISTS "${existing_ancestor}")
    get_filename_component(component "${existing_ancestor}" NAME)
    get_filename_component(next_ancestor "${existing_ancestor}" DIRECTORY)
    if(next_ancestor STREQUAL existing_ancestor)
        message(FATAL_ERROR "Cannot resolve OUTPUT_DIR ancestor: ${destination}")
    endif()
    set(missing_suffix "/${component}${missing_suffix}")
    set(existing_ancestor "${next_ancestor}")
endwhile()
file(REAL_PATH "${existing_ancestor}" resolved_ancestor)
set(canonical_destination "${resolved_ancestor}${missing_suffix}")
set(root_check "${source_root}")
set(destination_check "${canonical_destination}")
if(WIN32)
    string(TOLOWER "${root_check}" root_check)
    string(TOLOWER "${destination_check}" destination_check)
endif()
cmake_path(IS_PREFIX root_check "${destination_check}" NORMALIZE inside_repository)
set(build_check "${root_check}/build")
set(out_check "${root_check}/out")
cmake_path(IS_PREFIX build_check "${destination_check}" NORMALIZE inside_build)
cmake_path(IS_PREFIX out_check "${destination_check}" NORMALIZE inside_out)
if(inside_repository AND NOT inside_build AND NOT inside_out)
    message(FATAL_ERROR "Refusing source-tree OUTPUT_DIR; use a new path under build/ or out/, or outside the repository")
endif()
get_filename_component(parent "${destination}" DIRECTORY)
get_filename_component(name "${destination}" NAME)
if(name STREQUAL "")
    message(FATAL_ERROR "OUTPUT_DIR must name a new directory")
endif()
if(NOT GENERATOR)
    if(WIN32)
        set(GENERATOR "Visual Studio 17 2022")
    else()
        set(GENERATOR "Unix Makefiles")
    endif()
endif()
if(NOT DEFINED PLATFORM AND GENERATOR MATCHES "^Visual Studio")
    set(PLATFORM x64)
endif()
set(generator_args -G "${GENERATOR}")
if(PLATFORM)
    list(APPEND generator_args -A "${PLATFORM}")
endif()
if(TOOLSET)
    list(APPEND generator_args -T "${TOOLSET}")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(stage "${parent}/.${name}.stage-${nonce}")
if(EXISTS "${stage}" OR IS_SYMLINK "${stage}")
    message(FATAL_ERROR "Staging path already exists: ${stage}")
endif()
file(MAKE_DIRECTORY "${stage}/kit")
file(REAL_PATH "${stage}" recorded_stage)
function(checked label)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(WRITE "${stage}/${label}.log" "${output}\n${error}")
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${label} failed (${result}); staging diagnostics retained at ${stage}\n${output}\n${error}")
    endif()
endfunction()
checked(sdk-configure "${CMAKE_COMMAND}" -S "${source_root}/sdk/plugin" -B "${stage}/sdk-build" ${generator_args})
checked(sdk-install "${CMAKE_COMMAND}" --install "${stage}/sdk-build" --prefix "${stage}/kit" --config Release)

# Explicit file allowlist includes the helper DLL sources and packaged resource.
set(assets
    "sdk/plugin/README.md|README.md"
    "docs/plugin-packages.md|docs/plugin-packages.md"
    "docs/plugin-development.md|docs/plugin-development.md"
    "docs/plugin-realtime.md|docs/plugin-realtime.md"
    "examples/graphs/plugin-gain.json|examples/graphs/plugin-gain.json"
    "examples/graphs/plugin-realtime-gain.json|examples/graphs/plugin-realtime-gain.json"
    "sdk/plugin/scripts/verify-example.cmake|scripts/verify-example.cmake")
foreach(relative IN ITEMS CMakeLists.txt nodes.json cmake/manifest.json.in
    cmake/node_description.h.in cmake/package.cmake src/plugin.cpp
    src/example_algorithms.cpp src/example_algorithms.h resources/config/gain-scale.txt)
    list(APPEND assets "examples/plugins/standalone/${relative}|examples/standalone/${relative}")
endforeach()
foreach(relative IN ITEMS CMakeLists.txt host.cpp abi_c11.c)
    list(APPEND assets "tests/plugin_sdk/${relative}|tests/sdk-host/${relative}")
endforeach()
foreach(relative IN ITEMS CMakeLists.txt nodes.json src/plugin.cpp cmake/manifest.json.in cmake/node_description.h.in cmake/package.cmake)
    list(APPEND assets "examples/plugins/realtime/${relative}|examples/realtime/${relative}")
endforeach()
foreach(relative IN ITEMS CMakeLists.txt host.cpp abi_c11.c allocations.cpp)
    list(APPEND assets "tests/realtime_plugin_sdk/${relative}|tests/realtime-sdk-host/${relative}")
endforeach()
foreach(asset IN LISTS assets)
    string(REPLACE "|" ";" pair "${asset}")
    list(GET pair 0 input)
    list(GET pair 1 output)
    if(NOT EXISTS "${source_root}/${input}" OR IS_DIRECTORY "${source_root}/${input}")
        message(FATAL_ERROR "Missing public asset ${input}; staging retained at ${stage}")
    endif()
    get_filename_component(output_parent "${stage}/kit/${output}" DIRECTORY)
    file(MAKE_DIRECTORY "${output_parent}")
    configure_file("${source_root}/${input}" "${stage}/kit/${output}" COPYONLY)
endforeach()
# NO_REPLACE protects against a destination created while the export was running.
file(RENAME "${stage}/kit" "${destination}" RESULT rename_result NO_REPLACE)
if(NOT rename_result STREQUAL "0")
    message(FATAL_ERROR "Cannot publish devkit (${rename_result}); staging retained at ${stage}")
endif()
# This is the freshly created private staging path, never a caller-supplied tree.
cmake_path(NORMAL_PATH stage OUTPUT_VARIABLE normalized_stage)
file(REAL_PATH "${stage}" current_stage)
file(REAL_PATH "${parent}" canonical_parent)
cmake_path(IS_PREFIX canonical_parent "${current_stage}" NORMALIZE stage_under_parent)
if(NOT IS_ABSOLUTE "${normalized_stage}" OR NOT stage_under_parent
   OR IS_SYMLINK "${stage}" OR NOT current_stage STREQUAL recorded_stage
   OR current_stage STREQUAL canonical_parent)
    message(FATAL_ERROR "Devkit published, but staging cleanup refused: ${stage}")
endif()
file(REMOVE_RECURSE "${stage}")
message(STATUS "Plugin devkit exported to ${destination}")
