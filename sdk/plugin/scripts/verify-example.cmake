# Runs only the bundled example's ABI regression, not arbitrary plugin validation.
cmake_minimum_required(VERSION 3.25)
if(NOT WIN32)
    message(FATAL_ERROR "The example regression currently supports Windows x64 only")
endif()
get_filename_component(kit_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT EXISTS "${kit_root}/lib/cmake/AudioGraphPluginSDK/AudioGraphPluginSDKConfig.cmake"
   OR NOT EXISTS "${kit_root}/include/audiograph/plugin.h"
   OR NOT EXISTS "${kit_root}/examples/standalone/CMakeLists.txt"
   OR NOT EXISTS "${kit_root}/tests/sdk-host/CMakeLists.txt")
    message(FATAL_ERROR "Run this script from a complete exported developer kit")
endif()
if(NOT DEFINED WORK_ROOT OR NOT IS_ABSOLUTE "${WORK_ROOT}")
    message(FATAL_ERROR "Set WORK_ROOT to a new absolute directory outside the developer kit")
endif()
cmake_path(NORMAL_PATH WORK_ROOT)
# Resolve existing ancestors before the new leaf: aliases/junctions and case
# variants must not permit copying the example into its own source tree.
file(REAL_PATH "${kit_root}" canonical_kit)
set(ancestor "${WORK_ROOT}")
set(suffix "")
while(NOT EXISTS "${ancestor}")
    get_filename_component(component "${ancestor}" NAME)
    get_filename_component(next_ancestor "${ancestor}" DIRECTORY)
    if(next_ancestor STREQUAL ancestor OR IS_SYMLINK "${ancestor}")
        message(FATAL_ERROR "Cannot resolve WORK_ROOT parent")
    endif()
    set(suffix "/${component}${suffix}")
    set(ancestor "${next_ancestor}")
endwhile()
file(REAL_PATH "${ancestor}" canonical_parent)
string(TOLOWER "${canonical_kit}" compared_kit)
string(TOLOWER "${canonical_parent}${suffix}" compared_work)
cmake_path(IS_PREFIX compared_kit "${compared_work}" NORMALIZE inside_kit)
if(inside_kit OR EXISTS "${WORK_ROOT}" OR IS_SYMLINK "${WORK_ROOT}")
    message(FATAL_ERROR "WORK_ROOT must be new and outside the kit; nothing was overwritten")
endif()
if(NOT DEFINED GENERATOR)
    set(GENERATOR "Visual Studio 17 2022")
endif()
if(NOT DEFINED PLATFORM AND GENERATOR MATCHES "^Visual Studio")
    set(PLATFORM x64)
endif()
if(NOT DEFINED CONFIG)
    set(CONFIG Debug)
endif()
if(NOT CONFIG STREQUAL "Debug" AND NOT CONFIG STREQUAL "Release")
    message(FATAL_ERROR "CONFIG must be Debug or Release")
endif()
set(generator_args -G "${GENERATOR}")
if(PLATFORM)
    list(APPEND generator_args -A "${PLATFORM}")
endif()
if(TOOLSET)
    list(APPEND generator_args -T "${TOOLSET}")
endif()
function(checked)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result
        OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Example verification failed (${result})\n${output}\n${error}\nBuild files remain in ${WORK_ROOT}")
    endif()
endfunction()

file(MAKE_DIRECTORY "${WORK_ROOT}/source/example" "${WORK_ROOT}/source/sdk-host")
file(COPY "${kit_root}/examples/standalone/" DESTINATION "${WORK_ROOT}/source/example")
file(COPY "${kit_root}/tests/sdk-host/" DESTINATION "${WORK_ROOT}/source/sdk-host")
set(sdk_args "-DCMAKE_PREFIX_PATH=${kit_root}"
    "-DAudioGraphPluginSDK_DIR=${kit_root}/lib/cmake/AudioGraphPluginSDK"
    -DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF -DCMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY=OFF
    "-DCMAKE_BUILD_TYPE=${CONFIG}")
checked("${CMAKE_COMMAND}" -S "${WORK_ROOT}/source/example" -B "${WORK_ROOT}/plugin-build"
    ${generator_args} ${sdk_args})
checked("${CMAKE_COMMAND}" --build "${WORK_ROOT}/plugin-build" --config "${CONFIG}" --parallel 2)
set(package "${WORK_ROOT}/plugin-build/package/${CONFIG}")
file(READ "${package}/manifest.json" manifest)
string(JSON version GET "${manifest}" schema_version)
string(JSON count LENGTH "${manifest}" files)
if(NOT version EQUAL 2 OR NOT count EQUAL 4)
    message(FATAL_ERROR "Expected the bundled example's schema 2 four-member package")
endif()
set(paths ag_example_plugin.dll nodes.json org.audiograph.example.algorithms.dll resources/config/gain-scale.txt)
set(roles entry nodes dependency resource)
foreach(index RANGE 0 3)
    string(JSON path GET "${manifest}" files ${index} path)
    string(JSON role GET "${manifest}" files ${index} role)
    string(JSON expected_hash GET "${manifest}" files ${index} sha256)
    list(GET paths ${index} expected_path)
    list(GET roles ${index} expected_role)
    if(NOT path STREQUAL expected_path OR NOT role STREQUAL expected_role)
        message(FATAL_ERROR "Unexpected example member or role: ${path}")
    endif()
    file(SHA256 "${package}/${path}" actual_hash)
    if(NOT actual_hash STREQUAL expected_hash)
        message(FATAL_ERROR "Example package fingerprint differs: ${path}")
    endif()
endforeach()
checked("${CMAKE_COMMAND}" -S "${WORK_ROOT}/source/sdk-host" -B "${WORK_ROOT}/host-build"
    ${generator_args} ${sdk_args} "-DAG_TEST_PLUGIN_PATH=${package}/ag_example_plugin.dll")
checked("${CMAKE_COMMAND}" --build "${WORK_ROOT}/host-build" --config "${CONFIG}" --parallel 2)
checked("${CMAKE_CTEST_COMMAND}" --test-dir "${WORK_ROOT}/host-build" -C "${CONFIG}" --output-on-failure)
message(STATUS "Bundled example ABI/resource regression passed (${CONFIG})")
message(STATUS "Install the complete example package folder: ${package}")
message(STATUS "This is not a generic validator for custom plugins; validate those in AudioGraph")
