cmake_minimum_required(VERSION 3.25)
foreach(required SOURCE_ROOT TEST_ROOT GENERATOR)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
if(NOT CONFIG)
    set(CONFIG Debug)
endif()
function(checked)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Audio analysis SDK fixture failed (${result})\n${output}\n${error}")
    endif()
endfunction()
set(generator_args -G "${GENERATOR}")
if(PLATFORM)
    list(APPEND generator_args -A "${PLATFORM}")
endif()
if(TOOLSET)
    list(APPEND generator_args -T "${TOOLSET}")
endif()
set(prefix "${TEST_ROOT}/sdk-install")
checked("${CMAKE_COMMAND}" -S "${SOURCE_ROOT}/sdk/plugin" -B "${TEST_ROOT}/sdk-build" ${generator_args})
checked("${CMAKE_COMMAND}" --install "${TEST_ROOT}/sdk-build" --prefix "${prefix}" --config "${CONFIG}")
file(MAKE_DIRECTORY "${TEST_ROOT}/external-plugin" "${TEST_ROOT}/external-tests")
file(COPY "${SOURCE_ROOT}/examples/plugins/audio-analysis/" DESTINATION "${TEST_ROOT}/external-plugin")
file(COPY "${SOURCE_ROOT}/tests/audio_analysis_plugin/" DESTINATION "${TEST_ROOT}/external-tests")
checked("${CMAKE_COMMAND}" -S "${TEST_ROOT}/external-plugin" -B "${TEST_ROOT}/plugin-build" ${generator_args}
    "-DCMAKE_PREFIX_PATH=${prefix}")
checked("${CMAKE_COMMAND}" --build "${TEST_ROOT}/plugin-build" --config "${CONFIG}" --parallel 2)
set(package "${TEST_ROOT}/plugin-build/package/${CONFIG}")
set(plugin "${package}/org.audiograph.analysis.plugin.dll")
file(READ "${package}/manifest.json" manifest)
string(JSON schema GET "${manifest}" schema_version)
string(JSON count LENGTH "${manifest}" files)
if(NOT schema EQUAL 2 OR NOT count EQUAL 2)
    message(FATAL_ERROR "Audio analysis package requires schema 2 with exactly entry and nodes files")
endif()
set(has_entry FALSE)
set(has_nodes FALSE)
foreach(index RANGE 0 1)
    string(JSON path GET "${manifest}" files ${index} path)
    string(JSON role GET "${manifest}" files ${index} role)
    string(JSON hash GET "${manifest}" files ${index} sha256)
    if(path STREQUAL "org.audiograph.analysis.plugin.dll" AND role STREQUAL "entry" AND NOT has_entry)
        set(has_entry TRUE)
    elseif(path STREQUAL "nodes.json" AND role STREQUAL "nodes" AND NOT has_nodes)
        set(has_nodes TRUE)
    else()
        message(FATAL_ERROR "Unexpected audio analysis package path/role: ${path}: ${role}")
    endif()
    file(SHA256 "${package}/${path}" actual)
    if(NOT hash STREQUAL actual)
        message(FATAL_ERROR "Audio analysis package fingerprint mismatch: ${path}")
    endif()
endforeach()
if(NOT has_entry OR NOT has_nodes)
    message(FATAL_ERROR "Audio analysis package is missing entry or nodes")
endif()
checked("${CMAKE_COMMAND}" -S "${TEST_ROOT}/external-tests" -B "${TEST_ROOT}/harness-build" ${generator_args}
    "-DCMAKE_PREFIX_PATH=${prefix}" "-DAG_TEST_PLUGIN_PATH=${plugin}")
checked("${CMAKE_COMMAND}" --build "${TEST_ROOT}/harness-build" --config "${CONFIG}" --parallel 2)
checked("${CMAKE_CTEST_COMMAND}" --test-dir "${TEST_ROOT}/harness-build" -C "${CONFIG}" --output-on-failure)
