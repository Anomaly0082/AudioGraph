cmake_minimum_required(VERSION 3.25)
foreach(required SOURCE_ROOT TEST_ROOT GENERATOR)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
if(NOT CONFIG)
    set(CONFIG Debug)
endif()
function(checked)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Realtime SDK fixture failed (${result})\n${output}\n${error}")
    endif()
endfunction()
set(generator_args -G "${GENERATOR}")
if(PLATFORM)
    list(APPEND generator_args -A "${PLATFORM}")
endif()
if(TOOLSET)
    list(APPEND generator_args -T "${TOOLSET}")
endif()
set(prefix "${TEST_ROOT}/sdk-install")
checked("${CMAKE_COMMAND}" -S "${SOURCE_ROOT}/sdk/plugin" -B "${TEST_ROOT}/sdk-build" ${generator_args})
checked("${CMAKE_COMMAND}" --install "${TEST_ROOT}/sdk-build" --prefix "${prefix}" --config "${CONFIG}")
file(MAKE_DIRECTORY "${TEST_ROOT}/external-example" "${TEST_ROOT}/external-tests")
file(COPY "${SOURCE_ROOT}/examples/plugins/realtime/" DESTINATION "${TEST_ROOT}/external-example")
file(COPY "${SOURCE_ROOT}/tests/realtime_plugin_sdk/" DESTINATION "${TEST_ROOT}/external-tests")
file(READ "${TEST_ROOT}/external-example/nodes.json" nodes)
string(REPLACE "\r\n" "\n" nodes "${nodes}")
string(REPLACE "\n" "\r\n" nodes "${nodes}")
file(WRITE "${TEST_ROOT}/external-example/nodes.json" "${nodes}")
checked("${CMAKE_COMMAND}" -S "${TEST_ROOT}/external-example" -B "${TEST_ROOT}/plugin-build" ${generator_args} "-DCMAKE_PREFIX_PATH=${prefix}")
checked("${CMAKE_COMMAND}" --build "${TEST_ROOT}/plugin-build" --config "${CONFIG}" --parallel 2)
set(package "${TEST_ROOT}/plugin-build/package/${CONFIG}")
set(plugin "${package}/org.audiograph.realtime_example.plugin.dll")
file(READ "${package}/manifest.json" manifest)
string(JSON schema GET "${manifest}" schema_version)
string(JSON count LENGTH "${manifest}" files)
if(NOT schema EQUAL 2 OR NOT count EQUAL 2)
    message(FATAL_ERROR "Realtime package requires schema 2 with entry/nodes only")
endif()
set(paths org.audiograph.realtime_example.plugin.dll nodes.json)
set(roles entry nodes)
foreach(index RANGE 0 1)
    string(JSON path GET "${manifest}" files ${index} path)
    string(JSON role GET "${manifest}" files ${index} role)
    string(JSON hash GET "${manifest}" files ${index} sha256)
    list(GET paths ${index} expected_path)
    list(GET roles ${index} expected_role)
    file(SHA256 "${package}/${path}" actual)
    if(NOT path STREQUAL expected_path OR NOT role STREQUAL expected_role OR NOT hash STREQUAL actual)
        message(FATAL_ERROR "Realtime package fingerprint/role mismatch")
    endif()
endforeach()
checked("${CMAKE_COMMAND}" -S "${TEST_ROOT}/external-tests" -B "${TEST_ROOT}/host-build" ${generator_args} "-DCMAKE_PREFIX_PATH=${prefix}" "-DAG_TEST_PLUGIN_PATH=${plugin}" "-DAG_TEST_PLUGIN_SOURCE=${TEST_ROOT}/external-example" "-DAG_TEST_PLUGIN_GENERATED=${TEST_ROOT}/plugin-build/generated")
checked("${CMAKE_COMMAND}" --build "${TEST_ROOT}/host-build" --config "${CONFIG}" --parallel 2)
checked("${CMAKE_CTEST_COMMAND}" --test-dir "${TEST_ROOT}/host-build" -C "${CONFIG}" --output-on-failure)
